! Classical kicked top: rotation about y by p, then torsion about z by k*Z.
! Angles in radians.

&system
  p = 1.570796326794896     ! pi/2 = 1.570796326794896
  k = 1.0
/

&simulation
  n_kicks     = 500   ! kicks recorded after the transient
  n_transient = 0     ! kicks discarded before recording
  save_every  = 1     ! store every save_every-th kick
/

&initial
  mode     = 'grid'   ! 'single' | 'grid' | 'random'
  theta0   = 1.5      ! single: polar angle
  phi0     = 0.7      ! single: azimuthal angle
  n_theta  = 10       ! grid: points in Z = cos(theta) (equal-area grid)
  n_phi    = 10       ! grid: points in phi
  n_random = 100      ! random: number of points, uniform on the sphere
  seed     = 12345    ! random: seed
/

&output
  out_dir = 'output'
/

&lyapunov
  enabled  = .false.  ! compute the largest Lyapunov exponent of every initial condition
  n_renorm = 1        ! rescale the tangent vector every n_renorm kicks
/
